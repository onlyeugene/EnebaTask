# development | production. production disables the ?fail=1 homepage demo switch.
APP_ENV=development
PORT=8080

# Atlas M0 cluster. Same cluster for local and prod, different database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=eneba_dev

# Generate with: openssl rand -hex 32  (use a different value in production)
JWT_SECRET=change-me-to-64-hex-chars
JWT_ISSUER=eugene-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Exact origins, comma separated. Add the Vercel production URL.
CORS_ORIGINS=http://localhost:3000

# How long checkout holds keys. After this, other buyers can claim them, even if the cleanup job never ran.
RESERVATION_TTL=10m
BCRYPT_COST=12
